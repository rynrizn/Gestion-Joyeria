# =============================================================================
# VARIABLES DE ENTORNO DE MOONSTONE JOYERÍA (VITE / CLOUDFLARE PAGES)
# =============================================================================
# Para desarrollo local: Copia este archivo como `.env` o `.env.local`
# Para Cloudflare Pages: Configura estas variables en Settings > Environment Variables
# =============================================================================

# 1. URL del proyecto de Supabase (ejemplo: https://xyzcompany.supabase.co)
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co

# 2. Clave pública anónima (ANON / Publishable Key) de Supabase
# ⚠️ NUNCA utilices la clave service_role en el frontend
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
