# =============================================================================
# Moonstone / Gestión Joyería - Variables de Entorno de Ejemplo
# =============================================================================
# Copia este archivo como .env para desarrollo local:
#   cp .env.example .env
#
# NOTA: En Vite, todas las variables accesibles desde el cliente deben iniciar con VITE_
# NUNCA subas tu archivo .env real con credenciales al repositorio Git.
# =============================================================================

# --- Supabase Configuration ---
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key-publica

# --- Cloudinary Configuration (Gestión de Imágenes) ---
VITE_CLOUDINARY_CLOUD_NAME=tu_cloud_name
VITE_CLOUDINARY_UPLOAD_PRESET=tu_upload_preset
